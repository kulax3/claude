# Discord bot token (required)
# Get it from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Path to the claude CLI binary (default: "claude")
# Change if installed to a custom location, e.g. /usr/local/bin/claude
CLAUDE_COMMAND=claude

# Comma-separated list of channel IDs to restrict the bot to (optional)
# Leave empty to allow all channels
# Example: ALLOWED_CHANNEL_IDS=123456789,987654321
ALLOWED_CHANNEL_IDS=
