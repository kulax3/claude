{
  "manifest_version": 3,
  "name": "Google Tasks CSV エクスポート",
  "version": "1.0",
  "description": "Google Tasks を CSV ファイルにエクスポートします",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://tasks.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "760653555466-vog4bsoifrqojeue38sa8964cpa2c0vg.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/tasks.readonly"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Tasks エクスポート"
  }
}
